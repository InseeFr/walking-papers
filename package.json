{
  "name": "orchestrateur-saisie-papier",
  "private": true,
  "version": "1.0.12",
  "type": "module",
  "packageManager": "pnpm@11.28.4",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "_format": "prettier --ignore-unknown .",
    "format": "pnpm run _format -- --write",
    "format:check": "pnpm run _format -- --list-different",
    "prepare": "husky && vite-envs update-types",
    "generate-api": "orval"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@inseefr/lunatic": "^3.12.1",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1.127.9",
    "@tanstack/react-router-devtools": "^1.127.9",
    "axios": "^1.20.0",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "oidc-spa": "^8.6.17",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.0",
    "tsafe": "^1.8.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "nock": "^14.0.5",
    "orval": "8.46.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9.0",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vite-envs": "^4.6.2",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write --list-different"
    ],
    "!(*.js|*.jsx|*.ts|*.tsx)": "prettier --write --ignore-unknown --list-different"
  }
}
